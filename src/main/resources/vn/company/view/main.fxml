<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.company.controller.MainController" styleClass="root-pane">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <VBox spacing="2">
                <Label text="COMPANY" styleClass="header-title"/>
                <Label text="Quản lý nhân viên" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblConnection" styleClass="connection" text="Đang kết nối..."/>
            <Button text="Kết nối lại" onAction="#onReconnect" styleClass="btn-header"/>
        </HBox>
    </top>

    <center>
        <fx:include fx:id="employeeView" source="employee.fxml"/>
    </center>
</BorderPane>
