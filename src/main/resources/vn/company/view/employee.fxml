<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.company.controller.EmployeeController">

    <right>
        <VBox styleClass="card" spacing="12" prefWidth="380">
            <BorderPane.margin><Insets top="14" right="14" bottom="14" left="7"/></BorderPane.margin>
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <Label fx:id="lblFormTitle" text="Thông tin nhân viên" styleClass="card-title"/>
            <Label fx:id="lblFormHint" styleClass="form-hint" wrapText="true" maxWidth="Infinity"/>

            <GridPane hgap="10" vgap="9">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="SSN *" GridPane.rowIndex="0"/>
                <TextField fx:id="txtSsn" promptText="9 chữ số" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Tên (Fname) *" GridPane.rowIndex="1"/>
                <TextField fx:id="txtFname" promptText="Tối đa 15 ký tự" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Chữ lót (Minit)" GridPane.rowIndex="2"/>
                <TextField fx:id="txtMinit" promptText="1 chữ cái" maxWidth="95" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Họ (Lname) *" GridPane.rowIndex="3"/>
                <TextField fx:id="txtLname" promptText="Tối đa 15 ký tự" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Ngày sinh" GridPane.rowIndex="4"/>
                <DatePicker fx:id="dpBdate" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Giới tính" GridPane.rowIndex="5"/>
                <HBox spacing="16" alignment="CENTER_LEFT" GridPane.rowIndex="5" GridPane.columnIndex="1">
                    <RadioButton fx:id="rdoMale" text="Nam (M)"/>
                    <RadioButton fx:id="rdoFemale" text="Nữ (F)"/>
                </HBox>

                <Label text="Địa chỉ" GridPane.rowIndex="6"/>
                <TextField fx:id="txtAddress" promptText="Tối đa 50 ký tự" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Lương" GridPane.rowIndex="7"/>
                <TextField fx:id="txtSalary" promptText="VD: 30000" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <Label text="Người giám sát" GridPane.rowIndex="8"/>
                <HBox spacing="6" GridPane.rowIndex="8" GridPane.columnIndex="1">
                    <ComboBox fx:id="cboSupervisor" promptText="(Không có)" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnClearSupervisor" text="✕" onAction="#onClearSupervisor" styleClass="btn-icon">
                        <tooltip><Tooltip text="Bỏ chọn người giám sát"/></tooltip>
                    </Button>
                </HBox>

                <Label text="Phòng ban *" GridPane.rowIndex="9"/>
                <ComboBox fx:id="cboDepartment" promptText="Chọn phòng ban" maxWidth="Infinity"
                          GridPane.rowIndex="9" GridPane.columnIndex="1"/>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Chế độ xem -->
            <HBox fx:id="viewActions" spacing="8">
                <Button fx:id="btnEdit" text="Sửa" onAction="#onEdit" maxWidth="Infinity" prefWidth="100"
                        HBox.hgrow="ALWAYS" styleClass="btn-primary"/>
                <Button fx:id="btnDelete" text="Xóa" onAction="#onDelete" maxWidth="Infinity" prefWidth="100"
                        HBox.hgrow="ALWAYS" styleClass="btn-danger"/>
            </HBox>

            <!-- Chế độ thêm mới / sửa -->
            <HBox fx:id="editActions" spacing="8">
                <Button text="Lưu" onAction="#onSave" maxWidth="Infinity" prefWidth="100"
                        HBox.hgrow="ALWAYS" styleClass="btn-success"/>
                <Button text="Hủy" onAction="#onCancel" cancelButton="true" maxWidth="Infinity" prefWidth="100"
                        HBox.hgrow="ALWAYS" styleClass="btn-plain"/>
            </HBox>
        </VBox>
    </right>

    <center>
        <VBox styleClass="card" spacing="12">
            <BorderPane.margin><Insets top="14" right="7" bottom="14" left="14"/></BorderPane.margin>
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Danh sách nhân viên" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtSearch" promptText="Tìm SSN, tên, địa chỉ..." prefWidth="260" onAction="#onSearch"/>
                <Button text="Tìm" onAction="#onSearch" styleClass="btn-plain"/>
                <Button text="Làm mới" onAction="#onReload" styleClass="btn-plain"/>
                <Button fx:id="btnNew" text="+ Thêm mới" onAction="#onNew" styleClass="btn-primary"/>
            </HBox>

            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colSsn" text="SSN" prefWidth="90"/>
                    <TableColumn fx:id="colName" text="Họ tên" prefWidth="150"/>
                    <TableColumn fx:id="colBdate" text="Ngày sinh" prefWidth="90"/>
                    <TableColumn fx:id="colSex" text="GT" prefWidth="40"/>
                    <TableColumn fx:id="colAddress" text="Địa chỉ" prefWidth="190"/>
                    <TableColumn fx:id="colSalary" text="Lương" prefWidth="90"/>
                    <TableColumn fx:id="colSupervisor" text="Người giám sát" prefWidth="130"/>
                    <TableColumn fx:id="colDepartment" text="Phòng ban" prefWidth="120"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="Không có dữ liệu"/></placeholder>
            </TableView>

            <Label fx:id="lblStatus" styleClass="status"/>
        </VBox>
    </center>
</BorderPane>
